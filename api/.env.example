# =============================================================================
# Clima API - variables de entorno (plantilla)
# Copiar a .env y rellenar. NO versionar .env.
# Generar claves: openssl rand -base64 32  (una distinta por variable)
# =============================================================================

# --- Aplicación ---
APP_NAME=Clima API
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api
API_HOST=127.0.0.1
API_PORT=8000
# En producción /docs y /openapi.json se desactivan siempre; DOCS_ENABLED=true
# en producción es un error de configuración.
DOCS_ENABLED=true
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Orígenes exactos del futuro frontend (nunca "*" con cookies).
CORS_ORIGINS=["http://localhost:5173"]
# Proxies inversos de confianza (IPs o CIDR). Vacío si no hay proxy.
TRUSTED_PROXIES=[]

# --- PostgreSQL (servidor Ubuntu) ---
POSTGRES_HOST=192.168.56.10
POSTGRES_PORT=5432
POSTGRES_DB=UPP
POSTGRES_USER=tux
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10

# --- SQL Server (servidor Windows) ---
SQLSERVER_HOST=192.168.56.11
SQLSERVER_PORT=49834
SQLSERVER_DB=UPP
SQLSERVER_USER=tux
SQLSERVER_PASSWORD=cambia-esta-contraseña
SQLSERVER_ODBC_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=no
SQLSERVER_CONNECT_TIMEOUT=5
SQLSERVER_POOL_MAX_SIZE=5
# Directorio local con odbcinst.ini (ej. $HOME/.local/share/clima-api/odbc).
# Vacío si el driver está instalado globalmente en /etc/odbcinst.ini.
ODBC_CONFIG_DIR=

# --- Claves criptográficas (32 bytes en base64, DISTINTAS entre sí) ---
# openssl rand -base64 32
SESSION_SECRET_KEY=
TOTP_ENCRYPTION_KEY=
RECORD_ENCRYPTION_KEY=

# --- Alta de usuarios ---
# Sin valor: activo en desarrollo y desactivado en producción.
# Actívalo explícitamente en producción solo si el registro público es deseado.
REGISTRATION_ENABLED=true

# --- Sesiones y cookies ---
# En producción se fuerzan cookies Secure y nombre __Host-*.
SESSION_COOKIE_NAME=
SESSION_SECURE_COOKIES=
SESSION_SAMESITE=lax
SESSION_TTL_SECONDS=28800
SESSION_ABSOLUTE_TTL_SECONDS=43200
PENDING_SESSION_TTL_SECONDS=600

# --- Bloqueo de cuenta ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
TOTP_MAX_ATTEMPTS=5
TOTP_ENROLL_MAX_GENERATIONS_PER_HOUR=3

# --- Límites de solicitudes (por proceso; ver docs) ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_TOTP_PER_MINUTE=5
RATE_LIMIT_ENROLL_PER_MINUTE=3
RATE_LIMIT_RECORDS_PER_MINUTE=60
RATE_LIMIT_PUBLIC_PER_MINUTE=30

# --- Open-Meteo ---
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=8
WEATHER_CACHE_TTL_SECONDS=60

# --- Geocodificación inversa (Nominatim / OpenStreetMap) ---
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# Obligatorio: identificador real de la aplicación + contacto.
GEOCODING_USER_AGENT=Clima-API/1.0 (contacto@example.invalid)
GEOCODING_ACCEPT_LANGUAGE=es
GEOCODING_TIMEOUT_SECONDS=8
GEOCODING_CACHE_TTL_SECONDS=86400
GEOCODING_MIN_INTERVAL_SECONDS=1.0

# --- Integridad ---
INTEGRITY_ENABLED=true

# --- TLS (solo si se ejecuta uvicorn directamente con certificados) ---
SSL_CERTFILE=
SSL_KEYFILE=
